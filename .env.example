# Copy to ".env" and fill in. Keep in sync with src/env.js.
# Docker Compose interpolates "$" in values; wrap any secret containing "$" in single quotes.

# SQLite file (optional, default ./data/voltops.db)
# DATABASE_PATH="./data/voltops.db"

# Set to "true" only for LAN-only setups
# AUTH_DISABLED="true"

TESLA_CLIENT_ID=""
TESLA_CLIENT_SECRET=""
# Host port for the web UI (default 3000); TESLA_REDIRECT_URI must use the same port.
# VOLTOPS_PORT=3000
TESLA_REDIRECT_URI="http://localhost:3000/api/auth/callback"
# >= 32 chars
SESSION_SECRET=""
# 64 hex chars (AES-256-GCM key)
VOLTOPS_SECRET_KEY=""

# Optional: Tesla Fleet API region base URL (default: North America)
# TESLA_FLEET_BASE_URL="https://fleet-api.prd.na.vn.cloud.tesla.com"
