# Copy to ".env" and fill in. Keep in sync with src/env.js.
# Docker Compose interpolates "$" in values; wrap any secret containing "$" in single quotes.

# SQLite file (optional, default ./data/voltops.db)
# DATABASE_PATH="./data/voltops.db"

# Set to "true" only for LAN-only setups
# AUTH_DISABLED="true"

TESLA_CLIENT_ID=""
TESLA_CLIENT_SECRET=""
# Host port for the web UI (default 3000); TESLA_REDIRECT_URI must use the same port.
# VOLTOPS_PORT=3000
TESLA_REDIRECT_URI="http://localhost:3000/api/auth/callback"
# >= 32 chars
SESSION_SECRET=""
# 64 hex chars (AES-256-GCM key)
VOLTOPS_SECRET_KEY=""

# Optional: Tesla Fleet API region base URL (default: North America)
# TESLA_FLEET_BASE_URL="https://fleet-api.prd.na.vn.cloud.tesla.com"

# Optional: written onto every site by the worker (weather needs lat/lon; 2 decimals is enough)
# SITE_LATITUDE=
# SITE_LONGITUDE=
# Optional: your panels (Tesla has no panel data); shown in the Your system section
# SITE_PANEL_COUNT=
# SITE_PANEL_WATTS=
# TEMPERATURE_UNIT="F"

# Optional: Tesla Fleet API request budget per UTC month. Tesla bills ~5,000 requests a month after the free tier.
# The one-time history backfill stops at BACKFILL_MAX (0 = off) or when all requests reach the cap.
# TESLA_BACKFILL_MAX_PER_MONTH=2500
# TESLA_MONTHLY_REQUEST_CAP=4500

# Optional: demo mode without a Powerwall (worker seeds replay data when no Tesla site exists)
# VOLTOPS_DEMO=true
