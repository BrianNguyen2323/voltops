# Copy to ".env" and fill in. Keep in sync with src/env.js.

# SQLite file (optional, default ./data/voltops.db)
# DATABASE_PATH="./data/voltops.db"

# Set to "true" only for LAN-only setups
# AUTH_DISABLED="true"

TESLA_CLIENT_ID=""
TESLA_CLIENT_SECRET=""
TESLA_REDIRECT_URI="http://localhost:3000/api/auth/callback"
# >= 32 chars
SESSION_SECRET=""
# 64 hex chars (AES-256-GCM key)
VOLTOPS_SECRET_KEY=""
